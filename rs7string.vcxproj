<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F2B7C1E-7A1D-4C55-9B7E-5A1C0D7E7001}</ProjectGuid>
    <RootNamespace>rs7string</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- MASM (ml.exe) for the shared mid-hook thunks and the protect syscall (src/platform/*.asm). -->
  <ImportGroup Label="ExtensionSettings">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.props" />
  </ImportGroup>
  <PropertyGroup>
    <TargetName>dinput8</TargetName>
    <!-- No ILT: exports point at the stubs themselves (tools/tests/test_emu.py relies on it). -->
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(ProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <!-- /W4 /WX: a new warning fails the build (AGENTS.md "Build and gates"); third_party has warnings off. -->
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- C4405: an inline-asm operand named like a register/mnemonic (`push gs`, `push out`) is not the C variable. -->
      <TreatSpecificWarningsAsErrors>4405;%(TreatSpecificWarningsAsErrors)</TreatSpecificWarningsAsErrors>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;WIN32_LEAN_AND_MEAN;NOMINMAX;IMGUI_USER_CONFIG="overlay/imconfig_rs7.h";%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src;$(MSBuildThisFileDirectory)third_party\imgui;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <ModuleDefinitionFile>src\proxy.def</ModuleDefinitionFile>
      <BaseAddress>0x5E000000</BaseAddress>
      <RandomizedBaseAddress>false</RandomizedBaseAddress>
      <ImageHasSafeExceptionHandlers>false</ImageHasSafeExceptionHandlers>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\**\*.cpp" />
    <!-- Every feature has a hooks.cpp / registration.cpp: one object folder per source folder. -->
    <ClCompile Update="src\features\**\*.cpp" ObjectFileName="$(IntDir)%(RelativeDir)" />
  </ItemGroup>
  <!-- Dear ImGui v1.92.9b (MIT, third_party/imgui, unmodified) for the overlay (src/overlay). /Gy so the
       linker drops what the overlay never calls (and with it the imports it would bring). -->
  <ItemGroup>
    <ClCompile Include="third_party\imgui\imgui.cpp;third_party\imgui\imgui_draw.cpp;third_party\imgui\imgui_tables.cpp;third_party\imgui\imgui_widgets.cpp;third_party\imgui\backends\imgui_impl_dx9.cpp;third_party\imgui\backends\imgui_impl_win32.cpp">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <MASM Include="src\platform\*.asm" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)analyze.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" />
  </ImportGroup>
</Project>
